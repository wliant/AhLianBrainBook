# =============================================================================
# BrainBook deployment environment.
#
# Copy to deployment/.env.dev or deployment/.env.prod and fill in. Both files
# are gitignored and are the only secrets that ever reach the target host.
#
# Consumed twice: by docker compose for ${...} interpolation (REGISTRY,
# IMAGE_TAG, WEB_PORT, SANDBOX_DATABASE_URL) and as env_file for the app,
# intelligence and sandbox containers.
# =============================================================================

# -- Image registry -----------------------------------------------------------
# Both docker daemons must be able to reach this. If it is served over plain
# HTTP, both must also list it under insecure-registries.
REGISTRY=registry.example.lan:5000
# Overridden per deploy by scripts/deploy.sh (defaults to the short git SHA).
IMAGE_TAG=latest

# -- Deploy target ------------------------------------------------------------
# scripts/deploy.sh ssh's here. Never log in to run steps by hand - if a step
# is missing, add it to the script.
SSH_USER=deploy
DEPLOY_HOST=app-host.example.lan
DEPLOY_DIR=/srv/brainbook
SSH_PORT=22

# -- The single published port ------------------------------------------------
# The proxy publishes this and nothing else does. Give dev and prod
# different ones so both can run on the same host.
WEB_PORT=8080

# -- PostgreSQL (provided infrastructure, outside this stack) ------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5433/brainbook
SPRING_DATASOURCE_USERNAME=brainbook
SPRING_DATASOURCE_PASSWORD=

# -- Sandbox database (separate DB, separate role) ----------------------------
# Read by the sandbox service as DATABASE_URL; named apart from the app's
# datasource so the two can never be swapped. Percent-encode the password.
SANDBOX_DATABASE_URL=postgres://sandbox:CHANGEME@host.docker.internal:5432/sandbox?sslmode=disable

# -- MinIO / S3 (provided infrastructure, outside this stack) ------------------
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=CHANGEME
MINIO_SECRET_KEY=
MINIO_BUCKET=brainbook-attachments

# -- Public origins -------------------------------------------------------------
# Still load-bearing even though the UI and API share an origin: browsers send
# an Origin header on same-origin POST/PUT/DELETE, and Spring rejects any
# Origin not listed here with 403 Invalid CORS request. GETs carry no Origin,
# so a wrong value here looks healthy until the first write.
# Comma-separated; list every origin this environment is reachable on,
# including the bare host:port if you browse it that way.
CORS_ALLOWED_ORIGINS=https://brainbook.example.com,http://app-host.example.lan:8080

# -- Intelligence service ------------------------------------------------------
# Reached only by the app over the compose network; set in the compose file.
LLM_PROVIDER=anthropic
LOG_LEVEL=INFO

# -- Ollama (used when LLM_PROVIDER=ollama) ------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:32b
EMBEDDING_OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_OLLAMA_MODEL=nomic-embed-text

# -- Anthropic (used when LLM_PROVIDER=anthropic) ------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# -- LLM output ----------------------------------------------------------------
LLM_MAX_TOKENS=4096

# -- Per-agent LLM tuning ------------------------------------------------------
TEMPERATURE_GOAL_GENERATOR=0.7
TEMPERATURE_TOPIC_GENERATOR=0.4
TEMPERATURE_TOPIC_SCORER=0.1
TEMPERATURE_BULLET_EXPANDER=0.4
MAX_TOKENS_GOAL_GENERATOR=4096
MAX_TOKENS_TOPIC_GENERATOR=16000
MAX_TOKENS_TOPIC_SCORER=8192
MAX_TOKENS_BULLET_EXPANDER=8192

# Reasoning effort on Claude 5 models (low|medium|high|xhigh|max).
# This replaces temperature as the cost/quality lever.
EFFORT_GOAL_GENERATOR=low
EFFORT_TOPIC_SCORER=low

# -- AI tools ------------------------------------------------------------------
# Tavily web search (optional; falls back to DuckDuckGo).
TAVILY_API_KEY=
# Shared secret for the internal API between the two services. Blank = no auth.
INTERNAL_API_KEY=

# -- Sandbox limits ------------------------------------------------------------
SANDBOX_MAX_REPO_SIZE_MB=10000
SANDBOX_MAX_TOTAL_DISK_MB=307200
SANDBOX_CLONE_TIMEOUT_SEC=300
SANDBOX_MAX_CONCURRENT_CLONES=2
SANDBOX_MAX_COUNT=1000
SANDBOX_STALE_DAYS=30
# GitHub PAT for cloning private repos (optional).
GITHUB_PAT=

# -- Provisioning targets (used by scripts/provision.sh only) ------------------
# Container names of the provided infrastructure on the target host. The app
# database must be on an instance with pgvector available; the sandbox database
# does not need it and may live elsewhere. Defaults: postgres, postgres, minio.
#APP_DB_CONTAINER=postgres
#SANDBOX_DB_CONTAINER=postgres
#MINIO_CONTAINER=minio
# The role that may CREATE ROLE on the sandbox instance. Default: pgadmin.
#SANDBOX_DB_ADMIN=pgadmin
