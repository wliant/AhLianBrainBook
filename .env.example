# =============================================================================
# BrainBook local overrides.
#
# Optional: scripts/dev-up.sh picks this up if it exists, and everything below
# already has a working default in deployment/docker-compose.local.yml. Copy
# it to .env only to change ports or to point the AI features at a real LLM.
#
# Deploying to a server uses deployment/.env.<env> instead - see
# docs/deployment.md.
# =============================================================================

# -- Ports --------------------------------------------------------------------
# The single port the whole app is served on: UI at /, API at /api.
WEB_PORT=13000
# The backend, published on loopback only, for curling the API while debugging.
APP_PORT=18080
# The throwaway local Postgres and MinIO.
POSTGRES_PORT=15432
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# -- LLM provider ---------------------------------------------------------------
# "ollama" or "anthropic". AI features need one of them reachable.
LLM_PROVIDER=ollama
LOG_LEVEL=INFO

# -- Ollama (used when LLM_PROVIDER=ollama) -------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:32b
EMBEDDING_OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_OLLAMA_MODEL=nomic-embed-text

# -- Anthropic (used when LLM_PROVIDER=anthropic) -------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# -- AI tools -------------------------------------------------------------------
# Tavily web search (optional; falls back to DuckDuckGo).
TAVILY_API_KEY=
# Shared secret between the two services. Blank = no auth, which is fine here.
INTERNAL_API_KEY=

# -- Sandbox (git repo cloning for project clusters) ----------------------------
SANDBOX_MAX_REPO_SIZE_MB=1000
SANDBOX_MAX_TOTAL_DISK_MB=5120
SANDBOX_MAX_COUNT=10
# GitHub PAT for cloning private repos (optional).
GITHUB_PAT=
